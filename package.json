{
  "name": "rm-odontologia-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && node scripts/check-type.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "render:hero-fallback": "node scripts/render-hero-fallback.mjs",
    "check:content": "node scripts/check-content.mjs",
    "prebuild": "npm run check:content",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep accessibility",
    "test:mobile": "playwright test --project=mobile",
    "audit:mobile": "node scripts/mobile-overflow-audit.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lenis": "^1.1.20",
    "lucide-react": "^0.468.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
